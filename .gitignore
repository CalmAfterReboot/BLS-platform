.DS_Store
Thumbs.db

# Local session state — never commit
BLS-STATUS.md
EOFBLS-STATUS.md
.claude/local-context.md

# Sealed-secrets controller key backups (never commit)
bls-sealed-secrets-master*

# WU-2 sprint artefacts (timestamped cluster state dumps)
scripts/wu-2/artefacts/

# Phase sprint handoff docs (session continuity, never commit)
PHASE-*-HANDOFF.md

# Plan-v4 orchestration prompts — local-only weekly source-of-truth
docs/plan-v4/orchestration-prompts.md

# Downloaded artefacts from Claude sessions — local only
files/

# Operator-private operational state — never commit.
# Real Ansible inventory IPs live here; ship `hosts.example.yml` instead.
**/inventory/hosts.yml

# Terraform partial backend config — real storage account name lives in
# *.tfbackend; ship *.tfbackend.example. Init with:
#   terraform init -backend-config=backend.tfbackend
*.tfbackend

# Operator-private operator handbook (paths to creds, rotation procedures,
# private URLs). Reference-only — no literal secrets are stored here, but
# the file inventories where every credential lives, so it stays out of git.
OPERATOR-PRIVATE.md

# GPG-encrypted backups (covers OPERATOR-PRIVATE.md.gpg and any other
# locally-encrypted artefact). Safety net — the backup itself is encrypted
# at rest, but it has no place in git regardless.
*.gpg
