%%{init: {'theme':'neutral','flowchart':{'curve':'basis'}}}%%
flowchart LR
    %% System context (C4 L1) — BLS Platform and the external systems it
    %% genuinely interacts with at runtime. Audience actors (recruiters,
    %% hiring managers, the architect) live in the catalogue caption, not
    %% in the diagram.

    APIClient["API client"]:::actor

    BLS(("BLS Platform")):::system

    GitHub["GitHub"]:::external
    Azure["Microsoft Azure"]:::external
    Proxmox["Proxmox homelab"]:::external
    LLMProviders["LLM providers<br/>(OpenAI, Azure OpenAI, Ollama)"]:::external

    %% Runtime user → system
    APIClient -- "calls /v1/chat/completions" --> BLS

    %% System → external systems
    BLS -- "pushes commits" --> GitHub
    BLS -- "terraform apply" --> Azure
    BLS -- "kubectl, Ansible" --> Proxmox
    BLS -- "upstream API calls" --> LLMProviders

    %% GitOps reconciliation — GitHub is the source, ArgoCD pulls
    GitHub -. "GitOps pull (ArgoCD)" .-> Proxmox

    classDef actor fill:#dbeafe,stroke:#1e3a8a,stroke-width:1.5px,color:#0f172a;
    classDef system fill:#fef3c7,stroke:#92400e,stroke-width:2px,color:#0f172a;
    classDef external fill:#e5e7eb,stroke:#374151,stroke-width:1px,color:#0f172a;

%% Caption — supports BLS-PLATFORM-ENGINEERING-GUIDE.md §1. The BLS
%% Platform sits at the centre. The single human actor is an API client
%% (developer or service) hitting the LLM gateway — a real runtime user
%% of the running system. The four external systems are the ones the
%% platform genuinely interacts with: GitHub (source of truth + CI),
%% Microsoft Azure (P1 landing zone + Terraform remote state), the
%% Proxmox homelab (k3s cluster, ArgoCD, workloads P4 and P5), and the
%% upstream LLM providers consumed via the FastAPI/LiteLLM gateway. The
%% dotted edge from GitHub to Proxmox names the GitOps reconciliation
%% path — Git is the source, ArgoCD pulls. Audience actors (recruiter,
%% hiring manager, the architect-as-author) are deliberately out of this
%% diagram; a system context diagram records technical interactions, not
%% the portfolio's reading audience.
