%%{init: {'theme':'neutral','flowchart':{'curve':'basis'}}}%%
flowchart LR
    %% Scope discipline — left: what this portfolio claims; right: what
    %% it deliberately does not claim. Labels stay short; detail lives in
    %% the catalogue caption and in bridge-doc §6.

    subgraph IN["IN SCOPE"]
        direction TB
        I1["Hub-spoke Azure landing zone"]:::inscope
        I2["HA k3s on Proxmox"]:::inscope
        I3["Matrix ApplicationSet GitOps"]:::inscope
        I4["LLM gateway (live) — SealedSecret-backed"]:::inscope
        I5["Prometheus + Sealed Secrets"]:::inscope
        I6["Live OpenAI verification + committed evidence"]:::inscope
        I7["ADRs, runbooks, release tags"]:::inscope
    end

    subgraph OUT["OUT OF SCOPE"]
        direction TB
        O1["Multi-tenant production"]:::outscope
        O2["AWS / GCP production depth"]:::outscope
        O3["Platform team of N"]:::outscope
        O4["AKS currently running"]:::outscope
        O5["Every WU closed"]:::outscope
        O6["24/7 SRE on-call"]:::outscope
    end

    IN ~~~ OUT

    classDef inscope fill:#dcfce7,stroke:#166534,stroke-width:1.5px,color:#0f172a;
    classDef outscope fill:#f3f4f6,stroke:#6b7280,stroke-width:1px,color:#374151;

    style IN fill:#f0fdf4,stroke:#15803d,stroke-width:2px;
    style OUT fill:#fafafa,stroke:#9ca3af,stroke-width:2px,stroke-dasharray: 4 3;

%% Caption — supports BLS-PLATFORM-ENGINEERING-GUIDE.md §6 and Plan-v4
%% operating doc §5. Two columns. Left: what the portfolio has built and
%% is willing to be tested on — Terraform-built hub-spoke landing zone
%% (with remote state + locking), HA k3s on Proxmox (with the Ansible
%% node-hardening role), matrix-ApplicationSet GitOps reconciling N×M
%% Applications, the FastAPI/LiteLLM LLM gateway running with /metrics
%% exposed, kube-prometheus-stack and Sealed Secrets (runbook, restart
%% test, key backup), six ADRs, two runbooks, five release tags, and
%% incident response documented. Right: deliberate non-claims — no
%% multi-tenant production workload, no AWS/GCP production depth
%% inside this repo (GCP is on the P6 roadmap, not built), no
%% platform-team-of-N coordination (one-architect portfolio), AKS is
%% torn down for cost discipline (rebuild tracked as WU-5), open WUs
%% remain (WU-3, 4, 5, 6, 8, 9 — tracked and honest), and no formal
%% 24/7 SRE on-call (that's MSP context, not this repo). Scope
%% discipline is a hiring signal — a portfolio that pretends every
%% loose end is tied is a portfolio that cannot be trusted on the
%% tied ones.
